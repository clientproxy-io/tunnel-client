#!/bin/sh
. "$(dirname "$0")/common"

is_running() {
  [ -f "$PID_FILE" ] || return 1
  pid=$(cat "$PID_FILE" 2>/dev/null)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
  is_running && return 0
  if [ -z "$(env_get TUNNEL_ID)" ] || [ -z "$(env_get TUNNEL_API_KEY)" ]; then
    ui_message "Tunnel ID or API key is not set. Run the package wizard again or edit $ENV_FILE."
    return 1
  fi
  # Keep one previous log so the file cannot grow without bound across restarts.
  if [ -f "$LOG_FILE" ] && [ $(($(wc -c < "$LOG_FILE"))) -gt 5242880 ]; then
    mv -f "$LOG_FILE" "$LOG_FILE.1"
  fi
  # Double fork: the daemon is reparented to init, so it is detached from this
  # script and reaped on exit (a zombie child would still pass kill -0).
  (
    set -a
    . "$ENV_FILE"
    set +a
    export CLIENTPROXY_INSTALL_METHOD=synology
    "$PKG_DEST/bin/tunnel-client" < /dev/null >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
  )
  sleep 1
  if ! is_running; then
    ui_message "tunnel-client exited immediately — see $LOG_FILE"
    tail -n 5 "$LOG_FILE" >&2
    return 1
  fi
}

stop() {
  if is_running; then
    kill "$pid"
    i=0
    while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do sleep 1; i=$((i + 1)); done
    kill -9 "$pid" 2>/dev/null
  fi
  rm -f "$PID_FILE"
}

case "$1" in
  start)  start ;;
  stop)   stop ;;
  restart) stop; start ;;
  status) is_running && exit 0 || exit 3 ;;
  log)    echo "$LOG_FILE" ;;
  *)      exit 1 ;;
esac
